# DocuMint — environment
# Copy this to .env and fill in the two required values.
# .env is gitignored, so nothing here ever reaches GitHub.

# ============================================================
# REQUIRED
# ============================================================

# OpenRouter key. Used for BOTH embeddings and answer generation.
# Get one at https://openrouter.ai/keys
# Starts with "sk-or-".
OPENROUTER_API_KEY=

# Postgres connection string. The database must have the pgvector
# extension available. Supabase has it enabled by default.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Supabase gives you this under Project Settings > Database > Connection string.
# The app will not start without this, so set it before running.
DATABASE_URL=

# ============================================================
# OPTIONAL — every one of these has a working default in app/config.py.
# Leave them commented out unless you want to change behaviour.
# ============================================================

# Embeddings. If you change the model you must also change the vector(N)
# column in setup_db.sql and app/database.py, or inserts will fail.
# EMBEDDING_MODEL=openai/text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# Generation. Free models on OpenRouter get rate limited without warning,
# so the app walks the fallback list when the primary is unavailable.
# GENERATION_MODEL=google/gemma-4-26b-a4b-it:free
# FALLBACK_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,inclusionai/ling-3.0-tiny:free

# How documents get split before embedding
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50

# How many chunks to pull back per question
# TOP_K_RESULTS=5

# Uploads
# UPLOAD_DIR=./uploads
# MAX_FILE_SIZE_MB=10
